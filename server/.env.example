# ============================================================
#  M-Pesa STK Push — per-tenant credentials
#  Copy this file to .env and fill in what the client's
#  Safaricom Daraja app dashboard gives you. Nothing in the
#  code needs to change between clients — only this file.
# ============================================================

# "sandbox" while testing, "production" once the client goes live.
# This alone switches the API base URL — same code, no edits.
MPESA_ENV=sandbox

# From the client's Daraja app (developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Paybill or Till number
MPESA_SHORTCODE=

# Online Passkey shown alongside the shortcode on the Daraja app page
MPESA_PASSKEY=

# CustomerPayBillOnline for a Paybill number,
# CustomerBuyGoodsOnline for a Till number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Publicly reachable URL where Safaricom will POST the payment result.
# Must be this server's own /api/mpesa/callback URL once deployed
# (e.g. https://voi-gas-server.onrender.com/api/mpesa/callback).
# Safaricom cannot reach localhost — use the deployed Render URL.
MPESA_CALLBACK_URL=

# Optional — only needed if PartyB differs from MPESA_SHORTCODE
# (rare; leave blank unless the client's setup requires it)
MPESA_PARTY_B=

# Locks down which frontend origins may call this server.
# Comma-separated, e.g. https://voi-gas.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

PORT=4000
